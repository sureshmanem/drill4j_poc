# ---------------------------------------------------------------------------
# Drill4J PoC configuration
# ---------------------------------------------------------------------------
# All Drill4J images are published for linux/amd64. On Apple Silicon they run
# under the Podman machine's emulation layer, so we pin the platform below.
DRILL_PLATFORM=linux/amd64

# Drill4J component versions (kept in sync with the upstream demo project).
DRILL_ADMIN_BACKEND_VERSION=0.10.2
DRILL_UI_VERSION=0.10.2
# Tag of the java-agent *image* (the distribution container)...
JAVA_AGENT_IMAGE_TAG=0.8.0-38
# ...and the agent version it downloads into the shared volume at runtime.
JAVA_AGENT_VERSION=0.10.3

# API key recognised by the pre-seeded database (docker/db-init/drill-db-dump.sql).
# The agent uses it to authenticate against the admin backend.
DRILL_API_KEY=7_b67d19818d2968808b031c6ea8b182bb6f7492f33f41c9e89e70864d24741aae

# Logical identifiers reported by the agent and shown in the Drill4J UI.
DRILL_GROUP_ID=sample-group
DRILL_APP_ID=sample-app
DRILL_BUILD_VERSION=0.1.0
DRILL_ENV_ID=poc-1
# Only classes under this package prefix are instrumented for coverage.
DRILL_PACKAGE_PREFIXES=com/example

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
DRILL_ADMIN_BACKEND_DB_MAX_POOL_SIZE=50

# Host ports
SAMPLE_APP_PORT=8080
DRILL_ADMIN_PORT=8090
DRILL_UI_PORT=8091
